# ---------------------------------------------------------------------------
# Apex Morning Trading Desk — environment contract
# Copy to .env for local development. NEVER commit a filled-in .env.
# ---------------------------------------------------------------------------

# Database. Local dev uses a plain SQLite file via the libSQL driver adapter.
# Production points this at a hosted libSQL (Turso) URL, e.g.
#   DATABASE_URL=libsql://your-db.turso.io
#   DATABASE_AUTH_TOKEN=<turso token>
# Dev-to-prod is purely an env change — no code path change.
DATABASE_URL=file:./prisma/dev.db
DATABASE_AUTH_TOKEN=

# Anthropic — the ONLY two LLM touch points in the whole system.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_MATERIALITY=claude-sonnet-5
ANTHROPIC_MODEL_PROSE=claude-sonnet-5

# Telegram. Leave TELEGRAM_BOT_TOKEN unset to run in DRY-RUN mode
# (formatted messages are logged instead of sent — lets you exercise the whole
# system with no bot/account).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Continuous-monitoring fast loop. CRON_SECRET is required on every
# POST /api/cron/poll request. POLL_INTERVAL_MINUTES documents intent only;
# the real cadence is set by whatever cron actually calls the route.
CRON_SECRET=
POLL_INTERVAL_MINUTES=3

# Read-only web dashboard HTTP Basic Auth. If unset, the dashboard is open
# (fine for pure local dev, set both before deploying anywhere reachable).
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASS=

# Which market-data provider the pipeline uses. 'mock' is the only one built
# in v1; 'alpaca' is a documented future drop-in.
MARKET_DATA_PROVIDER=mock

# Risk + sizing configuration. Defaults match the plan's worked-out numbers.
STARTING_EQUITY=10000
KELLY_LAMBDA=0.25
KELLY_HARD_CAP_PCT=0.02
MAX_DAILY_TICKETS=3
MAX_DAILY_ENTRIES=2
MIN_ENTRY_WINDOW_MINUTES=5

# Optional deterministic seed for the mock provider so runs are reproducible.
MOCK_SEED=42
